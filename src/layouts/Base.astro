---
import '../styles/global.css';
import { NOW } from '../lib/data.ts';
import { SITE_NAME } from '../lib/jsonld.ts';
import { chicagoDate, formatStamp, TZ } from '../lib/time.ts';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  ogType?: 'website' | 'article';
  jsonld?: object | object[];
}

const { title, description, noindex = false, ogType = 'website', jsonld } = Astro.props;
const site = Astro.site!;
// build.format 'file' reports /venues/x.html at build time; canonical URLs are the clean form.
const path = Astro.url.pathname.replace(/(\/index)?\.html$/, '') || '/';
const canonical = new URL(path, site).href;
const fullTitle = path === '/' ? title : `${title} | ${SITE_NAME}`;
const ogImage = new URL('/og.png', site).href;
const ld = jsonld ? (Array.isArray(jsonld) ? jsonld : [jsonld]) : [];
const nav = [
  ['/', 'Tonight'],
  ['/this-weekend', 'Weekend'],
  ['/calendar', 'Calendar'],
  ['/venues', 'Venues'],
  ['/artists', 'Artists'],
];
---

<!doctype html>
<html lang="en" data-built={chicagoDate(NOW)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="815live upcoming shows" href="/rss.xml" />
    <link rel="alternate" type="text/calendar" title="815live calendar" href="/calendar.ics" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="815live: live music in Rockford and the 815" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#c73a22" />
    {ld.map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj).replace(/</g, '\\u003c')} />)}
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="wordmark" href="/" aria-label="815live home"><span class="wm-num">815</span><span class="wm-live">live</span></a>
        <nav aria-label="Main">
          {nav.map(([href, label]) => <a href={href} aria-current={path === href ? 'page' : undefined}>{label}</a>)}
        </nav>
      </div>
    </header>
    <main class="wrap">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <p class="footer-mark"><span class="wordmark small"><span class="wm-num">815</span><span class="wm-live">live</span></span> Live music in Rockford, Loves Park, Belvidere and the 815.</p>
        <p>
          <a href="/about">About</a> · <a href="/calendar.ics">Calendar (.ics)</a> · <a href="/rss.xml">RSS</a>
        </p>
        <p>
          Follow us: <a href="https://www.facebook.com/815livemusic" rel="me">Facebook</a> · <a href="https://www.instagram.com/815livemusic" rel="me">Instagram</a>
        </p>
        <p>Venues and bands: send show dates to <a href="mailto:shows@815live.com">shows@815live.com</a></p>
        <p class="updated">Listings updated <time datetime={NOW.toISOString()}>{formatStamp(NOW)}</time></p>
      </div>
    </footer>
    <script is:inline define:vars={{ tz: TZ }}>
      // The page was built at a fixed time; hide any day that has since passed.
      // "Today" is computed in America/Chicago, not the visitor's timezone.
      const today = new Intl.DateTimeFormat('en-CA', { timeZone: tz }).format(new Date());
      document.querySelectorAll('[data-show-date]').forEach((el) => {
        if (el.getAttribute('data-show-date') < today) el.hidden = true;
      });
      document.querySelectorAll('[data-show-list]').forEach((list) => {
        const empty = list.querySelector('[data-empty]');
        if (empty && !list.querySelector('[data-show-date]:not([hidden])')) empty.hidden = false;
      });
      // Day strip labels were written for the build date; fix them if a day has passed since.
      const strip = [...document.querySelectorAll('[data-strip-date]')];
      const built = document.documentElement.dataset.built;
      if (strip.length && built !== today) {
        const next = new Date(`${today}T12:00:00Z`);
        next.setUTCDate(next.getUTCDate() + 1);
        const tomorrow = next.toISOString().slice(0, 10);
        strip.forEach((li) => {
          const d = li.getAttribute('data-strip-date');
          const label = li.querySelector('.dc-label');
          li.querySelector('.day-chip').classList.toggle('is-today', d === today);
          if (d < today) li.hidden = true;
          else if (d === today) label.textContent = 'Tonight';
          else if (d === tomorrow) label.textContent = 'Tomorrow';
          else label.textContent = new Date(`${d}T12:00:00Z`).toLocaleDateString('en-US', { weekday: 'short', timeZone: 'UTC' });
        });
      }
      // Date picker: go straight to the day's page (without JS the form submits to /calendar).
      document.querySelectorAll('[data-date-jump]').forEach((form) => {
        const input = form.querySelector('input[type="date"]');
        const go = () => {
          if (input.value && input.value >= input.min && input.value <= input.max) location.href = `/date/${input.value}`;
        };
        form.addEventListener('submit', (e) => {
          e.preventDefault();
          go();
        });
        // A picked date navigates at once; typed dates wait for Enter/Go so half-typed ones don't.
        input.addEventListener('change', () => input.matches(':focus-visible') || go());
      });
    </script>
  </body>
</html>
