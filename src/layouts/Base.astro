---
import '../styles/global.css';
import { NOW } from '../lib/data.ts';
import { OG_IMAGE, SITE_NAME } from '../lib/jsonld.ts';
import { chicagoDate, formatStamp, TZ } from '../lib/time.ts';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  ogType?: 'website' | 'article';
  jsonld?: object | object[];
}

const { title, description, noindex = false, ogType = 'website', jsonld } = Astro.props;
const site = Astro.site!;
// build.format 'file' reports /venues/x.html at build time; canonical URLs are the clean form.
const path = Astro.url.pathname.replace(/(\/index)?\.html$/, '') || '/';
const canonical = new URL(path, site).href;
const fullTitle = path === '/' ? title : `${title} | ${SITE_NAME}`;
const ogImage = new URL(OG_IMAGE, site).href;
const ld = jsonld ? (Array.isArray(jsonld) ? jsonld : [jsonld]) : [];
// Phones scroll this row sideways already; Tomorrow is linked from the home page instead.
const nav = [
  ['/tonight', 'Tonight'],
  ['/this-weekend', 'Weekend'],
  ['/calendar', 'Calendar'],
  ['/venues', 'Venues'],
  ['/artists', 'Artists'],
];
// Brand glyphs from Font Awesome Free 6.5.2 (CC BY 4.0, fontawesome.com/license/free).
const social = [
  {
    href: 'https://www.facebook.com/815livemusic',
    label: '815live on Facebook',
    viewBox: '0 0 320 512',
    d: 'M80 299.3V512H196V299.3h86.5l18-97.8H196V166.9c0-51.7 20.3-71.5 72.7-71.5c16.3 0 29.4 .4 37 1.2V7.9C291.4 4 256.4 0 236.2 0C129.3 0 80 50.5 80 159.4v42.1H14v97.8H80z',
  },
  {
    href: 'https://www.instagram.com/815livemusic',
    label: '815live on Instagram',
    viewBox: '0 0 448 512',
    d: 'M224.1 141c-63.6 0-114.9 51.3-114.9 114.9s51.3 114.9 114.9 114.9S339 319.5 339 255.9 287.7 141 224.1 141zm0 189.6c-41.1 0-74.7-33.5-74.7-74.7s33.5-74.7 74.7-74.7 74.7 33.5 74.7 74.7-33.6 74.7-74.7 74.7zm146.4-194.3c0 14.9-12 26.8-26.8 26.8-14.9 0-26.8-12-26.8-26.8s12-26.8 26.8-26.8 26.8 12 26.8 26.8zm76.1 27.2c-1.7-35.9-9.9-67.7-36.2-93.9-26.2-26.2-58-34.4-93.9-36.2-37-2.1-147.9-2.1-184.9 0-35.8 1.7-67.6 9.9-93.9 36.1s-34.4 58-36.2 93.9c-2.1 37-2.1 147.9 0 184.9 1.7 35.9 9.9 67.7 36.2 93.9s58 34.4 93.9 36.2c37 2.1 147.9 2.1 184.9 0 35.9-1.7 67.7-9.9 93.9-36.2 26.2-26.2 34.4-58 36.2-93.9 2.1-37 2.1-147.8 0-184.8zM398.8 388c-7.8 19.6-22.9 34.7-42.6 42.6-29.5 11.7-99.5 9-132.1 9s-102.7 2.6-132.1-9c-19.6-7.8-34.7-22.9-42.6-42.6-11.7-29.5-9-99.5-9-132.1s-2.6-102.7 9-132.1c7.8-19.6 22.9-34.7 42.6-42.6 29.5-11.7 99.5-9 132.1-9s102.7-2.6 132.1 9c19.6 7.8 34.7 22.9 42.6 42.6 11.7 29.5 9 99.5 9 132.1s2.7 102.7-9 132.1z',
  },
];
---

<!doctype html>
<html lang="en" data-built={chicagoDate(NOW)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="815live upcoming shows" href="/rss.xml" />
    <link rel="alternate" type="text/calendar" title="815live calendar" href="/calendar.ics" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="815live: live music in Rockford and the 815" />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline define:vars={{ tz: TZ }}>
      // The visitor's night in Chicago: a night out runs until 4 AM, so at 1 AM
      // "tonight" is still yesterday's date. 'Tonight' from 5 PM, 'Today' before.
      const now = new Date();
      const hour = Number(new Intl.DateTimeFormat('en-US', { timeZone: tz, hour: 'numeric', hourCycle: 'h23' }).format(now));
      const night = new Intl.DateTimeFormat('en-CA', { timeZone: tz }).format(new Date(now - 4 * 3600e3));
      document.documentElement.dataset.nowNight = night;
      document.documentElement.dataset.nowPart = hour >= 17 || hour < 4 ? 'Tonight' : 'Today';
    </script>
    <meta name="theme-color" content="#c73a22" />
    {ld.map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj).replace(/</g, '\\u003c')} />)}
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="wordmark" href="/" aria-label="815live home"><span class="wm-num">815</span><span class="wm-live">live</span></a>
        <nav aria-label="Main">
          {nav.map(([href, label]) => <a href={href} aria-current={path === href ? 'page' : undefined}>{label}</a>)}
        </nav>
        <a class="submit-link" href="/submit" aria-current={path === '/submit' ? 'page' : undefined}>Submit a show</a>
      </div>
    </header>
    <main class="wrap">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <p class="footer-mark"><span class="wordmark small"><span class="wm-num">815</span><span class="wm-live">live</span></span> Live music in Rockford, Loves Park, Belvidere and the 815.</p>
        <p>
          <a href="/tonight">Tonight</a> · <a href="/tomorrow">Tomorrow</a> · <a href="/this-weekend">This weekend</a> ·
          <a href="/free">Free shows</a>
        </p>
        <p>
          <a href="/about">About</a> · <a href="/calendar.ics">Calendar (.ics)</a> · <a href="/rss.xml">RSS</a>
        </p>
        <p class="social">
          {
            social.map((s) => (
              <a href={s.href} rel="me" aria-label={s.label}>
                <svg viewBox={s.viewBox} aria-hidden="true" focusable="false"><path d={s.d} /></svg>
              </a>
            ))
          }
        </p>
        <p>Venues, bands, DJs and hosts: <a href="/submit">submit a show</a></p>
        <p class="disclaimer">Shows change; check with the venue before heading out.</p>
        <p class="updated">Listings updated <time datetime={NOW.toISOString()}>{formatStamp(NOW)}</time></p>
      </div>
    </footer>
    <script is:inline>
      // The page was built at a fixed time; hide any day that has since passed.
      // "Today" is computed in America/Chicago, not the visitor's timezone.
      const today = document.documentElement.dataset.nowNight;
      document.querySelectorAll('[data-show-date]').forEach((el) => {
        if (el.getAttribute('data-show-date') < today) el.hidden = true;
      });
      document.querySelectorAll('[data-show-list]').forEach((list) => {
        const empty = list.querySelector('[data-empty]');
        if (empty && !list.querySelector('[data-show-date]:not([hidden])')) empty.hidden = false;
      });
      const next = new Date(`${today}T12:00:00Z`);
      next.setUTCDate(next.getUTCDate() + 1);
      const tomorrow = next.toISOString().slice(0, 10);
      // Day links (dayHref in src/lib/data.ts): /tonight and /tomorrow are built for the
      // build's date, so on a page from an earlier day every day uses its date page.
      const fresh = today === document.documentElement.dataset.built;
      document.querySelectorAll('[data-day-link]').forEach((a) => {
        const d = a.getAttribute('data-day-link');
        a.href = fresh && d === today ? '/tonight' : fresh && d === tomorrow ? '/tomorrow' : `/date/${d}`;
      });
      // Day strip labels were written for the build's date and hour; fix them for now.
      const strip = [...document.querySelectorAll('[data-strip-date]')];
      if (strip.length) {
        strip.forEach((li) => {
          const d = li.getAttribute('data-strip-date');
          const label = li.querySelector('.dc-label');
          li.querySelector('.day-chip').classList.toggle('is-today', d === today);
          if (d < today) li.hidden = true;
          else if (d === today) label.textContent = document.documentElement.dataset.nowPart;
          else if (d === tomorrow) label.textContent = 'Tomorrow';
          else label.textContent = new Date(`${d}T12:00:00Z`).toLocaleDateString('en-US', { weekday: 'short', timeZone: 'UTC' });
        });
      }
      // Date picker: go straight to the day's page (without JS the form submits to /calendar).
      document.querySelectorAll('[data-date-jump]').forEach((form) => {
        const input = form.querySelector('input[type="date"]');
        const go = () => {
          if (input.value && input.value >= input.min && input.value <= input.max) location.href = `/date/${input.value}`;
        };
        form.addEventListener('submit', (e) => {
          e.preventDefault();
          go();
        });
        // A picked date navigates at once; typed dates wait for Enter/Go so half-typed ones don't.
        input.addEventListener('change', () => input.matches(':focus-visible') || go());
      });
    </script>
  </body>
</html>
