---
import '../../styles/preview-a.css';
import Preview from '../../components/design-preview/Preview.astro';
---

<Preview
  variant="a"
  name="Telephone Pole"
  mark="ticket"
  skyline="header"
  feel="A flyer stapled to a pole outside the bar: two inks and a yellow, pressed hard into newsprint, loud enough to read from across the street."
  fonts="Anton (headlines, times, numerals) + Archivo 400/600/800 (everything else)"
  layout="Flush-left, no cards: heavy black rules between shows, nights tagged with yellow tape strips, a linocut Rockford band under the header, offset-print shadows on buttons."
  palette={[
    { name: 'Newsprint', hex: '#e4e2dd' },
    { name: 'Ink', hex: '#141414', ink: '#e4e2dd' },
    { name: 'Ink, soft', hex: '#45423d', ink: '#e4e2dd' },
    { name: 'Poster pink', hex: '#b0124f', ink: '#ffffff' },
    { name: 'Tape yellow', hex: '#ffd21a' },
  ]}
/>
