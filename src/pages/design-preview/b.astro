  palette={[
    { name: 'House dark', hex: '#150d0c', ink: '#f6efdc' },
    { name: 'Velvet', hex: '#241411', ink: '#f6efdc' },
    { name: 'Bulb yellow', hex: '#ffc23d' },
    { name: 'Letter board', hex: '#f6efdc' },
    { name: 'Marquee red', hex: '#a3122a', ink: '#ffffff' },
    { name: 'Neon', hex: '#ff5468' },
  ]}
/>
