---
import '../../styles/preview-c.css';
import Preview from '../../components/design-preview/Preview.astro';
---

<Preview
  variant="c"
  name="Rock River Night"
  mark="postmark"
  skyline="header"
  feel="Standing on the Jefferson Street bridge at 11 PM: dark water, sodium lights on the ripples, and somewhere downtown a band is still playing."
  fonts="Big Shoulders Display 700/800/900 (headers, times; an Illinois-made civic face) + Atkinson Hyperlegible 400/700 (body, built for legibility)"
  layout="The skyline and river run across the top with the wordmark in the night sky; listings are open rows on deep blue with amber times, each night marked by a streetlight dot; a Rockford postmark stands in for the logo."
  palette={[
    { name: 'Night', hex: '#0b1724', ink: '#e7eef6' },
    { name: 'Deep water', hex: '#112236', ink: '#e7eef6' },
    { name: 'River', hex: '#173a5c', ink: '#e7eef6' },
    { name: 'Sodium amber', hex: '#ffb547' },
    { name: 'Moonlight', hex: '#bfd3e6' },
    { name: 'Text', hex: '#e7eef6' },
  ]}
/>
