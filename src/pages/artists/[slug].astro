---
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import ShowList from '../../components/ShowList.astro';
import { loadAll, upcomingShows, type Artist } from '../../lib/data.ts';
import { musicGroup } from '../../lib/jsonld.ts';

export const getStaticPaths = (async () => {
  const { artists } = await loadAll();
  return artists.map((artist) => ({ params: { slug: artist.id }, props: { artist } }));
}) satisfies GetStaticPaths;

const { artist } = Astro.props as { artist: Artist };
const a = artist.data;
const shows = (await upcomingShows()).filter((s) => s.artists.some((x) => x.id === artist.id));
const links = [['Website', a.website], ...Object.entries(a.socials)].filter((l): l is [string, string] => Boolean(l[1]));
const label = (k: string) => k.charAt(0).toUpperCase() + k.slice(1);
---

<Base
  title={`${a.name}: upcoming shows`}
  description={`${a.name}${a.genres.length ? ` (${a.genres.join(', ')})` : ''} from ${a.hometown}. Upcoming live shows around Rockford, IL.`}
  noindex={a.placeholder}
  jsonld={musicGroup(artist, Astro.site!)}
>
  {a.placeholder && <span class="badge">Sample artist</span>}
  <h1>{a.name}</h1>
  <p class="meta">{a.hometown}</p>
  {a.genres.length > 0 && <ul class="chips">{a.genres.map((g) => <li>{g}</li>)}</ul>}
  <p>{a.bio}</p>
  {links.length > 0 && (
    <p>{links.map(([k, url], i) => <>{i > 0 && ' · '}<a href={url} rel="noopener">{label(k)}</a></>)}</p>
  )}
  <h2>Upcoming shows</h2>
  <ShowList shows={shows} empty={`No upcoming shows listed for ${a.name}.`} />
</Base>
