---
import Base from '../layouts/Base.astro';
import CategoryNav from '../components/CategoryNav.astro';
import DateJump from '../components/DateJump.astro';
import DayStrip from '../components/DayStrip.astro';
import HomeLater from '../components/HomeLater.astro';
import HomeNight from '../components/HomeNight.astro';
import WeeklyList from '../components/WeeklyList.astro';
import { isMusic } from '../lib/categories.ts';
import { loadAll, NOW, pageListing, splitMusic } from '../lib/data.ts';
import { website } from '../lib/jsonld.ts';
import { dayPart, groupByNight, laterWindow, nightOf, RECURRING_LIST_DAYS } from '../lib/shows.ts';
import { addDays, chicagoDate, formatMediumDay } from '../lib/time.ts';

// Three sections: today, the rest of this week, and a short "coming up".
// The build sorts nights into them for its own date; the inline script below
// re-sorts on load for the visitor's night, so the page stays right all day
// and the day after. That's why the page carries the previous night and a
// few spare days beyond what the build itself shows. Music leads: other events
// only show under tonight's "Also happening", and a night with no music is
// left out of the later sections. A quiet night (no music today) never says
// "no live music": it says "Quiet night for live music" and puts the next 7
// days right under that note, above tonight's other events.
const COMING_UP_SHOWS = 8;
const { shows } = await loadAll();
const { shows: listed, weekly: allWeekly } = await pageListing();
const weekly = splitMusic(allWeekly);
const anyOther = listed.some((s) => !isMusic(s.category));
const today = chicagoDate(NOW);
const first = addDays(today, -1);
const last = addDays(today, 21);
const recurringLast = addDays(today, RECURRING_LIST_DAYS + 1);
const nights = groupByNight(
  shows.filter((s) => {
    const n = nightOf(s);
    return n >= first && n <= (s.recurring ? recurringLast : last);
  }),
);

const music = (n: (typeof nights)[number]) => n.shows.filter((s) => isMusic(s.category));
const quiet = !nights.some((n) => n.date === today && music(n).length > 0);
const later = laterWindow(today, quiet);
const oneOffs = (n: (typeof nights)[number]) => music(n).filter((s) => !s.recurring).length;
let comingCount = 0;
const placed = nights.map((n) => {
  let where: 'today' | 'later' | 'coming' | undefined =
    n.date < today ? undefined : n.date === today ? 'today' : !music(n).length ? undefined : n.date <= later.end ? 'later' : 'coming';
  if (where === 'coming') {
    if (!oneOffs(n) || comingCount >= COMING_UP_SHOWS) where = undefined;
    else comingCount += oneOffs(n);
  }
  return { ...n, where };
});
const inSection = (where: string) => placed.filter((n) => n.where === where);
const anyTonight = inSection('today').length > 0;
const laterSection = { window: later, nights: inSection('later'), anyOther };
---

<Base
  title="815live: Live music in Rockford, IL"
  description="Upcoming live music in Rockford, Loves Park, Belvidere and the 815: local bands at bars, breweries and small venues, all in one place."
  jsonld={website(Astro.site!)}
>
  <section class="tonight" aria-labelledby="tonight-heading" data-home="today" data-quiet={quiet ? '' : undefined}>
    <div class="tonight-head">
      <h1 id="tonight-heading"><span data-home-part>{dayPart(NOW)}</span> in the <span class="accent">815</span></h1>
      <p class="tonight-tz"><span data-home-date>{formatMediumDay(today)}</span></p>
    </div>
    <DayStrip />
    <nav class="home-quick" aria-label="Quick links">
      <a href="/tonight">Tonight's full list</a>
      <a href="/tomorrow">Tomorrow</a>
      <a href="/this-weekend">This weekend</a>
      <a href="/free">Free shows</a>
    </nav>
    <p class="tonight-empty" data-home-empty hidden={!quiet}>Quiet night for live music. Here's what's coming up.</p>
    <div class="quiet-slot" data-quiet-slot>{quiet && <HomeLater {...laterSection} />}</div>
    <div class="tonight-list" data-home-list hidden={!anyTonight}>
      {placed.filter((n) => !n.where || n.where === 'today').map((n) => <HomeNight {...n} />)}
    </div>
  </section>

  {!quiet && <HomeLater {...laterSection} />}

  <section class="home-sec home-coming" aria-labelledby="coming-heading" data-home="coming">
    <h2 id="coming-heading" class="section-heading">Coming up</h2>
    <div data-home-list>{inSection('coming').map((n) => <HomeNight {...n} />)}</div>
    <p class="more-link"><a href="/calendar">See everything on the calendar →</a></p>
  </section>

  <div class="home-browse">
    <DateJump />
    <CategoryNav />
  </div>
  <WeeklyList rules={weekly.music} />
  <WeeklyList rules={weekly.other} heading="Also every week" />

  <script is:inline define:vars={{ comingUpShows: COMING_UP_SHOWS }}>
    // Re-sort the nights for the visitor's own night (set in Base's <head>).
    // The rules match laterWindow() and nightOf() in src/lib/shows.ts.
    (() => {
      const { nowNight: night, nowPart: daypart } = document.documentElement.dataset;
      const add = (d, n) => {
        const t = new Date(`${d}T12:00:00Z`);
        t.setUTCDate(t.getUTCDate() + n);
        return t.toISOString().slice(0, 10);
      };
      const fmt = (d, opts) => new Date(`${d}T12:00:00Z`).toLocaleDateString('en-US', { timeZone: 'UTC', ...opts });
      const medium = (d) => fmt(d, { weekday: 'long', month: 'short', day: 'numeric' });
      const short = (d) => fmt(d, { weekday: 'short', month: 'short', day: 'numeric' });
      const nights = [...document.querySelectorAll('[data-night]')];
      // Date order, not page order: the build parks nights it doesn't show in the first list.
      nights.sort((a, b) => a.dataset.night.localeCompare(b.dataset.night));
      // Music cards are a night's direct children; other events sit in [data-also].
      const musicOf = (g) => g.querySelectorAll(':scope > .show-card').length;
      const tonight = nights.find((g) => g.dataset.night === night);
      const quiet = !tonight || !musicOf(tonight);
      const wd = new Date(`${night}T12:00:00Z`).getUTCDay();
      const week = quiet || wd === 0 || wd === 6;
      const end = add(night, week ? 7 : 7 - wd);

      const box = {};
      document.querySelectorAll('[data-home]').forEach((el) => {
        box[el.dataset.home] = { el, list: el.querySelector(':scope > [data-home-list]'), empty: el.querySelector(':scope > [data-home-empty]') };
      });
      // A quiet night: the week ahead goes right under the "Quiet night" note.
      box.today.el.toggleAttribute('data-quiet', quiet);
      if (quiet) document.querySelector('[data-quiet-slot]').append(box.later.el);
      else box.today.el.after(box.later.el);
      document.querySelector('[data-home-part]').textContent = daypart;
      document.querySelector('[data-home-date]').textContent = medium(night);
      document.querySelector('[data-later-label]').textContent = week ? 'Next 7 days' : 'Later this week';
      document.querySelector('[data-later-range]').textContent = `${short(add(night, 1))} – ${short(end)}`;

      let coming = 0;
      nights.forEach((g) => {
        const d = g.dataset.night;
        const music = musicOf(g);
        const oneOffs = g.querySelectorAll(':scope > .show-card:not([data-recurring])').length;
        let where = d < night ? null : d === night ? 'today' : !music ? null : d <= end ? 'later' : 'coming';
        if (where === 'coming') {
          if (!oneOffs || coming >= comingUpShows) where = null;
          else coming += oneOffs;
        }
        g.hidden = !where;
        (where ? box[where] : box.today).list.append(g);
      });
      for (const [name, b] of Object.entries(box)) {
        const any = !!b.list.querySelector('[data-night]:not([hidden])');
        if (name === 'today') b.list.hidden = !any;
        else if (b.empty) b.empty.hidden = !!b.list.querySelector('[data-night]:not([hidden]) > .show-card');
      }
      box.today.empty.hidden = !quiet;
    })();
  </script>
</Base>
