---
// Design preview scaffold (redesign branch only; delete once a direction is applied).
// Same real listings in every direction; each page brings its own CSS.
import RockfordSkyline from '../RockfordSkyline.astro';
import Mark815 from '../Mark815.astro';
import ShowCard from '../ShowCard.astro';
import DayStrip from '../DayStrip.astro';
import { coverLabel, loadAll, NOW, showsByDate, showTitle } from '../../lib/data.ts';
import { chicagoDate, formatDay, formatMediumDay, formatTime } from '../../lib/time.ts';
import { dayPart } from '../../lib/shows.ts';

interface Props {
  variant: 'a' | 'b' | 'c';
  name: string;
  feel: string;
  palette: { name: string; hex: string; ink?: string }[];
  fonts: string;
  layout: string;
  mark: 'ticket' | 'bulbs' | 'postmark';
  skyline: 'header' | 'footer';
}
const { variant, name, feel, palette, fonts, layout, mark, skyline } = Astro.props;
const today = chicagoDate(NOW);
const byDate = await showsByDate();
const nights = [...byDate].filter(([d, l]) => d >= today && l.length).sort(([a], [b]) => a.localeCompare(b)).slice(0, 3);
const { shows } = await loadAll();
const sample = shows.find((s) => s.id === '2026-11-28-legends-mckenna-faith-winters') ?? nights[0][1][0];
const nav = [['/tonight', 'Tonight'], ['/this-weekend', 'Weekend'], ['/calendar', 'Calendar'], ['/venues', 'Venues'], ['/artists', 'Artists']];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{`Preview ${variant.toUpperCase()}: ${name} | 815live`}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body class={`pv pv-${variant}`}>
    <div class="pv-bar">
      <span>Design preview <strong>{variant.toUpperCase()}</strong>: {name}</span>
      <span class="pv-switch">
        {['a', 'b', 'c'].map((v) => <a href={`/design-preview/${v}`} aria-current={v === variant ? 'page' : undefined}>{v.toUpperCase()}</a>)}
      </span>
    </div>

    <header class="site-header">
      <div class="wrap head-row">
        <a class="wordmark" href="/" aria-label="815live home">
          <Mark815 kind={mark} class="wm-mark" />
          <span class="wm-live">live</span>
        </a>
        <a class="submit-link" href="/submit">Submit a show</a>
        <nav aria-label="Main">{nav.map(([href, label], i) => <a href={href} aria-current={i === 0 ? 'page' : undefined}>{label}</a>)}</nav>
      </div>
      {skyline === 'header' && <RockfordSkyline class="sky-head" />}
    </header>

    <main class="wrap">
      <section class="tonight">
        <div class="tonight-head">
          <h1>{dayPart(NOW)} in the <span class="accent">815</span></h1>
          <p class="tonight-tz">{formatMediumDay(today)} · Rockford &amp; around</p>
        </div>
        <DayStrip />
        {
          nights.map(([date, list], i) => (
            <section class:list={['day', i === 0 && 'day-first']}>
              <h2 class="day-heading">{formatMediumDay(date)}</h2>
              {list.slice(0, 4).map((show) => <ShowCard show={show} />)}
              {list.length > 4 && <p class="more-link"><a href={`/date/${date}`}>+ {list.length - 4} more that night</a></p>}
            </section>
          ))
        }
      </section>

      <section class="detail-sample" aria-labelledby="sample-h">
        <p class="eyebrow">Listing page</p>
        <p class="category">Live music</p>
        <h1 id="sample-h">{showTitle(sample)}</h1>
        <dl class="facts">
          <dt>When</dt><dd>{formatDay(sample.date)} at {formatTime(sample.startTime)}</dd>
          <dt>Where</dt><dd><a href={`/venues/${sample.venue.id}`}>{sample.venue.data.name}</a><br />{sample.venue.data.address}, {sample.venue.data.city}</dd>
          <dt>Cover</dt><dd>{coverLabel(sample.cover) ?? 'Not announced'}</dd>
        </dl>
        <p><a class="button" href={`/shows/${sample.id}`}>Full listing</a></p>
      </section>

      <section class="spec" aria-labelledby="spec-h">
        <h2 id="spec-h" class="section-heading">The spec</h2>
        <p class="spec-feel">{feel}</p>
        <ul class="swatches">
          {palette.map((p) => (
            <li style={`--sw:${p.hex};--sw-ink:${p.ink ?? '#000'}`}><span class="sw-chip">Aa</span><span><strong>{p.name}</strong><br /><code>{p.hex}</code></span></li>
          ))}
        </ul>
        <p><strong>Type:</strong> {fonts}</p>
        <p><strong>Layout:</strong> {layout}</p>
      </section>
    </main>

    <footer class="site-footer">
      {skyline === 'footer' && <RockfordSkyline class="sky-foot" />}
      <div class="wrap">
        <p class="footer-mark"><Mark815 kind={mark} class="foot-mark" /> Live music in Rockford, Loves Park, Belvidere and the 815.</p>
        <p><a href="/tonight">Tonight</a> · <a href="/tomorrow">Tomorrow</a> · <a href="/this-weekend">This weekend</a> · <a href="/free">Free shows</a></p>
        <p class="disclaimer">Shows change; check with the venue before heading out.</p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  /* Shared bones for all three previews; the direction CSS does the rest. */
  *, *::before, *::after { box-sizing: border-box; }
  body.pv { margin: 0; }
  .pv .wrap { max-width: 46rem; margin: 0 auto; padding: 0 1rem; }
  .pv .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .pv-bar { display: flex; justify-content: space-between; gap: 1rem; padding: 0.4rem 1rem; font: 13px/1.4 system-ui, sans-serif; background: #000; color: #fff; }
  .pv-bar a { color: #fff; margin-left: 0.6rem; }
  .pv-bar a[aria-current] { color: #000; background: #fff; padding: 0 0.35rem; text-decoration: none; }
  .pv .head-row { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 1.25rem; padding-top: 0.75rem; padding-bottom: 0.75rem; }
  .pv .wordmark { display: inline-flex; align-items: center; gap: 0.35rem; text-decoration: none; }
  .pv .wm-mark { height: 2.6rem; width: auto; }
  .pv .submit-link { margin-left: auto; white-space: nowrap; }
  .pv .site-header nav { display: flex; gap: 0.25rem 1rem; flex-basis: 100%; overflow-x: auto; white-space: nowrap; scrollbar-width: none; }
  @media (min-width: 40rem) { .pv .head-row { flex-wrap: nowrap; } .pv .site-header nav { flex-basis: auto; order: 1; min-width: 0; } .pv .submit-link { order: 2; } }
  .pv main.wrap { padding-top: 1.25rem; padding-bottom: 3rem; }
  .pv h1, .pv h2, .pv h3 { margin: 0 0 0.5rem; line-height: 1.1; }
  .pv .show-card { display: grid; grid-template-columns: 4.6rem 1fr; gap: 0.75rem; padding: 0.7rem 0; }
  .pv .show-card h3 a { text-decoration: none; color: inherit; }
  .pv .show-card p { margin: 0.1rem 0 0; }
  .pv .show-time { white-space: nowrap; font-variant-numeric: tabular-nums; }
  .pv .trust { font-size: 0.8rem; line-height: 1.8; }
  .pv .trust a, .pv .meta a { color: inherit; }
  .pv .trust .src { overflow-wrap: anywhere; }
  .pv .day-strip { margin: 0 -1rem 1.25rem; }
  .pv .day-strip ul { display: flex; gap: 0.5rem; margin: 0; padding: 0.25rem 1rem 0.5rem; list-style: none; overflow-x: auto; scrollbar-width: thin; }
  .pv .day-strip li { flex: 0 0 auto; }
  .pv .day-chip { position: relative; display: flex; flex-direction: column; align-items: center; min-width: 4.9rem; padding: 0.45rem 0.6rem 0.4rem; text-decoration: none; }
  .pv .dc-count { align-self: stretch; text-align: center; font-size: 0.8rem; margin-top: 0.25rem; padding-top: 0.25rem; }
  .pv .facts { display: grid; grid-template-columns: max-content 1fr; gap: 0.4rem 1rem; margin: 1rem 0 1.25rem; padding: 1rem; }
  .pv .facts dd { margin: 0; }
  .pv .button { display: inline-block; padding: 0.7rem 1.25rem; text-decoration: none; }
  .pv .detail-sample, .pv .spec { margin-top: 3rem; }
  .pv .swatches { display: grid; grid-template-columns: repeat(auto-fill, minmax(10rem, 1fr)); gap: 0.6rem; padding: 0; list-style: none; }
  .pv .swatches li { display: flex; gap: 0.6rem; align-items: center; font-size: 0.85rem; line-height: 1.3; }
  .pv .sw-chip { flex: none; display: grid; place-items: center; width: 2.6rem; height: 2.6rem; background: var(--sw); color: var(--sw-ink); font-weight: 700; border: 1px solid currentColor; }
  .pv .site-footer .wrap { padding-top: 1.25rem; padding-bottom: 2rem; }
  .pv .site-footer p { margin: 0.3rem 0; }
  .pv .footer-mark { display: flex; align-items: center; gap: 0.6rem; }
  .pv .foot-mark { height: 2.2rem; width: auto; flex: none; }
  .pv .rockford-skyline { display: block; width: 100%; height: clamp(120px, 22vw, 240px); }
</style>
